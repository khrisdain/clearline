# Copy to .env and fill in. Never commit .env.
CLEARLINE_PROVIDER=fake            # fake | cohere | ollama
CLEARLINE_STORE=memory             # memory | postgres
COHERE_API_KEY=
CLEARLINE_DATABASE_URL=postgresql://clearline:clearline@localhost:5432/clearline
CLEARLINE_AUTH_MODE=dev            # dev | oidc  (dev is refused when CLEARLINE_ENV=production)
CLEARLINE_OIDC_ISSUER=http://localhost:8081/realms/clearline
CLEARLINE_OIDC_AUDIENCE=clearline-api
CLEARLINE_OLLAMA_URL=http://localhost:11434
